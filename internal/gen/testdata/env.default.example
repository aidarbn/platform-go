# Generated by platformgo from platformgo.yaml. Do not edit.
# Service: app

# platform
APP_ROLE=all
OPS_ADDR=:9090
SHUTDOWN_TIMEOUT=20s
SHUTDOWN_PHASES=false
LOG_LEVEL=info
LOG_FORMAT=json

# module postgres
# database address (required)
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# connection limit
DATABASE_MAX_CONNS=10
# connections kept open
DATABASE_MIN_CONNS=0
# apply migrations on start
DATABASE_MIGRATE=true

# module s3
# storage address, host:port (required)
S3_ENDPOINT=127.0.0.1:9000
# access key (required)
S3_ACCESS_KEY=minioadmin
# secret key (required)
S3_SECRET_KEY=minioadmin
# https to the storage
S3_USE_SSL=false
# region, when the storage needs one
S3_REGION=
# where public buckets are served, for example https://example.com/storage
S3_PUBLIC_URL=
