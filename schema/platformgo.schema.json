{
  "$id": "https://github.com/aidarbn/platform-go/schema/platformgo.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "How a project on platform-go is put together: modules and their technical options. Business settings live in settings.yaml.",
  "properties": {
    "modules": {
      "additionalProperties": false,
      "description": "enabled modules; a module is enabled by its section and removed by deleting it",
      "properties": {
        "admin": {
          "additionalProperties": false,
          "description": "platform module admin; requires postgres",
          "properties": {},
          "type": [
            "object",
            "null"
          ]
        },
        "api": {
          "additionalProperties": false,
          "description": "platform module api",
          "properties": {
            "buf": {
              "additionalProperties": false,
              "description": "buf.yaml on top of the platform's",
              "properties": {
                "breaking_except": {
                  "default": [],
                  "description": "breaking rules left out of FILE: FILE_NO_DELETE, RPC_NO_DELETE, MESSAGE_NO_DELETE, FIELD_NO_DELETE",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "deps": {
                  "default": [],
                  "description": "buf modules the proto files import, added to the platform's: buf.build/grpc-ecosystem/grpc-gateway",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "openapi": {
              "additionalProperties": false,
              "description": "the OpenAPI description of the API",
              "properties": {
                "documents": {
                  "default": [],
                  "description": "descriptions for one audience each, generator platform only: openapi.\u003cname\u003e.bundle.yaml with the operations selected and the components they use, served at /openapi/\u003cname\u003e.yaml",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "description": {
                        "description": "info.description of the document; the base's when empty",
                        "type": "string"
                      },
                      "exclude": {
                        "additionalProperties": false,
                        "description": "operations that stay out of the included ones, matched the same way",
                        "properties": {
                          "services": {
                            "default": [],
                            "description": "gRPC services by full name, package.Service",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "tag_groups": {
                            "default": [],
                            "description": "groups of x-tagGroups, as the description names them, base.yaml's included",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "tags": {
                            "default": [],
                            "description": "sections, tags of operations",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "type": "object"
                      },
                      "include": {
                        "additionalProperties": false,
                        "description": "operations that go in: an operation matches a listed group, tag or service; everything when empty",
                        "properties": {
                          "services": {
                            "default": [],
                            "description": "gRPC services by full name, package.Service",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "tag_groups": {
                            "default": [],
                            "description": "groups of x-tagGroups, as the description names them, base.yaml's included",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "tags": {
                            "default": [],
                            "description": "sections, tags of operations",
                            "items": {
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "type": "object"
                      },
                      "name": {
                        "description": "the name in the file and the URL: lower case letters, digits, - and _; all is the whole description",
                        "type": "string"
                      },
                      "title": {
                        "description": "info.title of the document; the base's when empty",
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "generator": {
                  "default": "platform",
                  "description": "platform: the platform's own generator describes the API as the gateway serves it, split by proto file with a bundle; connect: protoc-gen-connect-openapi writes one api/openapi/openapi.yaml, as before v0.10.0; none: the project keeps api/openapi/openapi.yaml itself",
                  "enum": [
                    "platform",
                    "connect",
                    "none"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            "proto_dir": {
              "default": "proto",
              "description": "folder of the proto files, the buf module, relative to the project root",
              "type": "string"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "enums": {
          "additionalProperties": false,
          "description": "platform module enums; requires api",
          "properties": {
            "domain": {
              "default": "internal/domain",
              "description": "Go package scanned for go-enum markers, relative to the project root",
              "type": "string"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "i18n": {
          "additionalProperties": false,
          "description": "platform module i18n; requires postgres, api",
          "properties": {},
          "type": [
            "object",
            "null"
          ]
        },
        "monitoring": {
          "additionalProperties": false,
          "description": "platform module monitoring",
          "properties": {},
          "type": [
            "object",
            "null"
          ]
        },
        "postgres": {
          "additionalProperties": false,
          "description": "platform module postgres",
          "properties": {
            "compose": {
              "additionalProperties": false,
              "description": "the local database: its service in docker-compose.yml and DATABASE_URL in .env.example",
              "properties": {
                "command": {
                  "default": [],
                  "description": "arguments of the postgres server: [-c, max_connections=300]",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "data_dir": {
                  "default": "/var/lib/postgresql",
                  "description": "folder of the data inside the container, where the postgres-data volume goes: /var/lib/postgresql/data for images before 18",
                  "type": "string"
                },
                "db": {
                  "default": "app",
                  "description": "name of the database",
                  "type": "string"
                },
                "enabled": {
                  "default": true,
                  "description": "generate the service; false leaves it out for a database service of the project's own in docker-compose.override.yml",
                  "type": "boolean"
                },
                "image": {
                  "default": "postgres:18-alpine",
                  "description": "Docker image of the database",
                  "type": "string"
                },
                "init": {
                  "description": "a folder or a .sql or .sh file, relative to the project root, mounted into /docker-entrypoint-initdb.d: run once on an empty database",
                  "type": "string"
                },
                "password": {
                  "default": "app",
                  "description": "password of the user",
                  "type": "string"
                },
                "port": {
                  "default": 5432,
                  "description": "port on 127.0.0.1 the database listens on",
                  "type": "integer"
                },
                "user": {
                  "default": "app",
                  "description": "user of the database",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "sqlc": {
              "additionalProperties": false,
              "description": "static queries: where sqlc.yaml, the queries and the generated code live, and Go types on top of the platform's",
              "properties": {
                "dir": {
                  "default": "db",
                  "description": "folder of the generated sqlc.yaml, relative to the project root",
                  "type": "string"
                },
                "emit_interface": {
                  "default": true,
                  "description": "generate the Querier interface",
                  "type": "boolean"
                },
                "out": {
                  "default": "internal/db/sqlcgen",
                  "description": "folder of the generated Go code, relative to the project root",
                  "type": "string"
                },
                "overrides": {
                  "default": [],
                  "description": "Go types of database types or columns; they come before the platform's, and sqlc takes the first match",
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "column": {
                        "description": "column, table.column or schema.table.column; or set db_type",
                        "type": "string"
                      },
                      "db_type": {
                        "description": "database type, as sqlc names it: int4, pg_catalog.numeric; or set column",
                        "type": "string"
                      },
                      "go_type": {
                        "description": "Go type: a name such as int64, or an object",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "import": {
                                "description": "import path of the type",
                                "type": "string"
                              },
                              "package": {
                                "description": "package name when it differs from the last element of import",
                                "type": "string"
                              },
                              "pointer": {
                                "default": false,
                                "description": "a pointer to the type",
                                "type": "boolean"
                              },
                              "slice": {
                                "default": false,
                                "description": "a slice of the type",
                                "type": "boolean"
                              },
                              "type": {
                                "description": "type name",
                                "type": "string"
                              }
                            },
                            "required": [
                              "type"
                            ],
                            "type": "object"
                          }
                        ]
                      },
                      "nullable": {
                        "default": false,
                        "description": "the override is for nullable columns",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "go_type"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "package": {
                  "default": "sqlcgen",
                  "description": "Go package name of the generated code",
                  "type": "string"
                },
                "queries": {
                  "default": "queries",
                  "description": "folder of the *.sql queries, relative to dir",
                  "type": "string"
                },
                "renames": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "default": {},
                  "description": "Go names of columns and tables, sqlc rename: {url: URL}",
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "rbac": {
          "additionalProperties": false,
          "description": "platform module rbac; requires api",
          "properties": {},
          "type": [
            "object",
            "null"
          ]
        },
        "river": {
          "additionalProperties": false,
          "description": "platform module river; requires postgres",
          "properties": {},
          "type": [
            "object",
            "null"
          ]
        },
        "s3": {
          "additionalProperties": false,
          "description": "platform module s3",
          "properties": {},
          "type": [
            "object",
            "null"
          ]
        },
        "settings": {
          "additionalProperties": false,
          "description": "platform module settings; requires postgres",
          "properties": {
            "schema": {
              "default": "settings.yaml",
              "description": "business settings schema file, relative to the project root",
              "type": "string"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "web": {
          "additionalProperties": false,
          "description": "platform module web; requires api",
          "properties": {},
          "type": [
            "object",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "platform": {
      "description": "platform version the project is on",
      "pattern": "^v\\d+\\.\\d+\\.\\d+",
      "type": "string"
    },
    "project": {
      "additionalProperties": false,
      "properties": {
        "go": {
          "description": "Go version",
          "type": "string"
        },
        "module": {
          "description": "Go module path",
          "type": "string"
        },
        "service": {
          "description": "service name in logs; the last element of the module path by default",
          "type": "string"
        }
      },
      "required": [
        "module"
      ],
      "type": "object"
    },
    "schema": {
      "const": 1,
      "description": "format version of this file"
    }
  },
  "required": [
    "schema",
    "project"
  ],
  "title": "platformgo.yaml",
  "type": "object"
}
